    <!-- * * * Link Definitions * * * -->

     <link name="base_link">
        <visual>
            <origin xyz="0 0 0.0015" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.09" length="0.003"/>
            </geometry>
            <material name="Cyan1">
           		<color rgba="0 0.9 0.9 1.0"/>
         	</material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0015" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.09" length="0.003"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </link>

