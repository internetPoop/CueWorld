<?xml version="1.0"?>
<robot name="blue_cube">
  <link name="base_link">
    <contact>
      <lateral_friction value="0.9"/>
      <rolling_friction value="0.03"/>
      <spinning_friction value="0.03"/>
      <restitution value="0.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.12"/>
      </geometry>
      <material name="blue">
        <color rgba="0.150 0.320 0.880 1.000"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.12"/>
      </geometry>
    </collision>
  </link>
</robot>
