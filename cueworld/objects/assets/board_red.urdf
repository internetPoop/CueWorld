<?xml version="1.0"?>
<robot name="board_red">
  <material name="red">
    <color rgba="0.850 0.120 0.120 1.000"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <inertia ixx="2.17" ixy="0" ixz="0" iyy="0.083" iyz="0" izz="2.08"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 1.0"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 1.0"/>
      </geometry>
    </collision>
  </link>
</robot>
