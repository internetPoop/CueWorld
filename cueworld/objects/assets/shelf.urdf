<?xml version="1.0"?>
<robot name="shelf">
  <material name="wood_mat">
    <color rgba="0.6 0.4 0.2 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="50.0"/>
      <origin xyz="0 0 0.9" rpy="0 0 0"/>
      <inertia ixx="16.0" ixy="0" ixz="0" iyy="16.0" iyz="0" izz="5.3"/>
    </inertial>
    
    <!-- Bottom -->
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.8 0.8 0.05"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.8 0.8 0.05"/></geometry>
    </collision>

    <!-- Top -->
    <visual>
      <origin xyz="0 0 1.775" rpy="0 0 0"/>
      <geometry><box size="0.8 0.8 0.05"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 1.775" rpy="0 0 0"/>
      <geometry><box size="0.8 0.8 0.05"/></geometry>
    </collision>

    <!-- Left -->
    <visual>
      <origin xyz="-0.375 0 0.9" rpy="0 0 0"/>
      <geometry><box size="0.05 0.8 1.7"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.375 0 0.9" rpy="0 0 0"/>
      <geometry><box size="0.05 0.8 1.7"/></geometry>
    </collision>

    <!-- Right -->
    <visual>
      <origin xyz="0.375 0 0.9" rpy="0 0 0"/>
      <geometry><box size="0.05 0.8 1.7"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="0.375 0 0.9" rpy="0 0 0"/>
      <geometry><box size="0.05 0.8 1.7"/></geometry>
    </collision>

    <!-- Back -->
    <visual>
      <origin xyz="0 -0.375 0.9" rpy="0 0 0"/>
      <geometry><box size="0.7 0.05 1.7"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="0 -0.375 0.9" rpy="0 0 0"/>
      <geometry><box size="0.7 0.05 1.7"/></geometry>
    </collision>

    <!-- Shelf 1 -->
    <visual>
      <origin xyz="0 0.025 0.6" rpy="0 0 0"/>
      <geometry><box size="0.7 0.75 0.05"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0.025 0.6" rpy="0 0 0"/>
      <geometry><box size="0.7 0.75 0.05"/></geometry>
    </collision>

    <!-- Shelf 2 -->
    <visual>
      <origin xyz="0 0.025 1.2" rpy="0 0 0"/>
      <geometry><box size="0.7 0.75 0.05"/></geometry>
      <material name="wood_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0.025 1.2" rpy="0 0 0"/>
      <geometry><box size="0.7 0.75 0.05"/></geometry>
    </collision>
  </link>
</robot>
