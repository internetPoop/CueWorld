<?xml version="1.0"?>
<!-- ToyBoard: 暖色系ストライプ (board.urdf と同形状) -->
<robot name="board_toy">
  <material name="red">
    <color rgba="1.0 0.2 0.1 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 0.9 0.1 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <inertia ixx="2.17" ixy="0" ixz="0" iyy="0.083" iyz="0" izz="2.08"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.833" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.333"/>
      </geometry>
      <material name="red"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.334"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.167" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.333"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 1.0"/>
      </geometry>
    </collision>
  </link>
</robot>
