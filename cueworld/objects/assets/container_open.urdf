<?xml version="1.0"?>
<robot name="container_open">
  <material name="box_mat">
    <color rgba="0.8 0.8 0.2 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    
    <!-- Bottom -->
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.01"/></geometry>
      <material name="box_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry><box size="0.2 0.2 0.01"/></geometry>
    </collision>

    <!-- Front -->
    <visual>
      <origin xyz="0 0.095 0.1" rpy="0 0 0"/>
      <geometry><box size="0.2 0.01 0.2"/></geometry>
      <material name="box_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0.095 0.1" rpy="0 0 0"/>
      <geometry><box size="0.2 0.01 0.2"/></geometry>
    </collision>

    <!-- Back -->
    <visual>
      <origin xyz="0 -0.095 0.1" rpy="0 0 0"/>
      <geometry><box size="0.2 0.01 0.2"/></geometry>
      <material name="box_mat"/>
    </visual>
    <collision>
      <origin xyz="0 -0.095 0.1" rpy="0 0 0"/>
      <geometry><box size="0.2 0.01 0.2"/></geometry>
    </collision>

    <!-- Left -->
    <visual>
      <origin xyz="-0.095 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.01 0.18 0.2"/></geometry>
      <material name="box_mat"/>
    </visual>
    <collision>
      <origin xyz="-0.095 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.01 0.18 0.2"/></geometry>
    </collision>

    <!-- Right -->
    <visual>
      <origin xyz="0.095 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.01 0.18 0.2"/></geometry>
      <material name="box_mat"/>
    </visual>
    <collision>
      <origin xyz="0.095 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.01 0.18 0.2"/></geometry>
    </collision>
  </link>
</robot>
