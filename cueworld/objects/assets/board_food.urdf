<?xml version="1.0"?>
<!-- FoodBoard: 緑系ストライプ (board.urdf と同形状) -->
<robot name="board_food">
  <material name="green">
    <color rgba="0.1 0.7 0.2 1.0"/>
  </material>
  <material name="lime">
    <color rgba="0.6 0.9 0.2 1.0"/>
  </material>
  <material name="pale_green">
    <color rgba="0.85 0.95 0.75 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <inertia ixx="2.17" ixy="0" ixz="0" iyy="0.083" iyz="0" izz="2.08"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.833" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.333"/>
      </geometry>
      <material name="green"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.334"/>
      </geometry>
      <material name="lime"/>
    </visual>

    <visual>
      <origin xyz="0 0 0.167" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.333"/>
      </geometry>
      <material name="pale_green"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 1.0"/>
      </geometry>
    </collision>
  </link>
</robot>
