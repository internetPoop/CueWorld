<?xml version="1.0"?>
<robot name="lid">
  <material name="lid_mat">
    <color rgba="0.8 0.4 0.2 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.22 0.02"/>
      </geometry>
      <material name="lid_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.22 0.02"/>
      </geometry>
    </collision>
  </link>
</robot>
