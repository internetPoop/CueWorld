<?xml version="1.0"?>
<robot name="container_closed">
  <material name="box_mat">
    <color rgba="0.8 0.8 0.2 1.0"/>
  </material>
  <material name="lid_mat">
    <color rgba="0.8 0.4 0.2 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
    
    <!-- Bottom -->
    <visual><origin xyz="0 0 0.005" rpy="0 0 0"/><geometry><box size="0.2 0.2 0.01"/></geometry><material name="box_mat"/></visual>
    <collision><origin xyz="0 0 0.005" rpy="0 0 0"/><geometry><box size="0.2 0.2 0.01"/></geometry></collision>

    <!-- Front -->
    <visual><origin xyz="0 0.095 0.1" rpy="0 0 0"/><geometry><box size="0.2 0.01 0.2"/></geometry><material name="box_mat"/></visual>
    <collision><origin xyz="0 0.095 0.1" rpy="0 0 0"/><geometry><box size="0.2 0.01 0.2"/></geometry></collision>

    <!-- Back -->
    <visual><origin xyz="0 -0.095 0.1" rpy="0 0 0"/><geometry><box size="0.2 0.01 0.2"/></geometry><material name="box_mat"/></visual>
    <collision><origin xyz="0 -0.095 0.1" rpy="0 0 0"/><geometry><box size="0.2 0.01 0.2"/></geometry></collision>

    <!-- Left -->
    <visual><origin xyz="-0.095 0 0.1" rpy="0 0 0"/><geometry><box size="0.01 0.18 0.2"/></geometry><material name="box_mat"/></visual>
    <collision><origin xyz="-0.095 0 0.1" rpy="0 0 0"/><geometry><box size="0.01 0.18 0.2"/></geometry></collision>

    <!-- Right -->
    <visual><origin xyz="0.095 0 0.1" rpy="0 0 0"/><geometry><box size="0.01 0.18 0.2"/></geometry><material name="box_mat"/></visual>
    <collision><origin xyz="0.095 0 0.1" rpy="0 0 0"/><geometry><box size="0.01 0.18 0.2"/></geometry></collision>
  </link>

  <link name="lid_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.02"/></geometry>
      <material name="lid_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.22 0.22 0.02"/></geometry>
    </collision>
  </link>

  <joint name="lid_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lid_link"/>
    <origin xyz="0 0 0.21" rpy="0 0 0"/>
  </joint>
</robot>
