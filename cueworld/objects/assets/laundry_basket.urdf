<?xml version="1.0"?>
<robot name="laundry_basket">
  <material name="basket_mat">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
    
    <!-- Bottom -->
    <visual><origin xyz="0 0 0.01" rpy="0 0 0"/><geometry><box size="0.5 0.5 0.02"/></geometry><material name="basket_mat"/></visual>
    <collision><origin xyz="0 0 0.01" rpy="0 0 0"/><geometry><box size="0.5 0.5 0.02"/></geometry></collision>

    <!-- Left -->
    <visual><origin xyz="-0.24 0 0.31" rpy="0 0 0"/><geometry><box size="0.02 0.5 0.58"/></geometry><material name="basket_mat"/></visual>
    <collision><origin xyz="-0.24 0 0.31" rpy="0 0 0"/><geometry><box size="0.02 0.5 0.58"/></geometry></collision>

    <!-- Right -->
    <visual><origin xyz="0.24 0 0.31" rpy="0 0 0"/><geometry><box size="0.02 0.5 0.58"/></geometry><material name="basket_mat"/></visual>
    <collision><origin xyz="0.24 0 0.31" rpy="0 0 0"/><geometry><box size="0.02 0.5 0.58"/></geometry></collision>

    <!-- Front -->
    <visual><origin xyz="0 0.24 0.31" rpy="0 0 0"/><geometry><box size="0.46 0.02 0.58"/></geometry><material name="basket_mat"/></visual>
    <collision><origin xyz="0 0.24 0.31" rpy="0 0 0"/><geometry><box size="0.46 0.02 0.58"/></geometry></collision>

    <!-- Back -->
    <visual><origin xyz="0 -0.24 0.31" rpy="0 0 0"/><geometry><box size="0.46 0.02 0.58"/></geometry><material name="basket_mat"/></visual>
    <collision><origin xyz="0 -0.24 0.31" rpy="0 0 0"/><geometry><box size="0.46 0.02 0.58"/></geometry></collision>
  </link>
</robot>
