<?xml version="1.0"?>
<!--
  BaseEnv デフォルト壁と同寸:
    wall_thickness=0.01 (全厚 0.02), wall_height=1.0,
    南北壁スパン 2*xh = 5.0 (arena_half_extents=(2.5, 2.0) 時)
  ローカル座標: X=厚み, Y=壁沿い幅, Z=高さ
-->
<robot name="board">
  <material name="cyan">
    <color rgba="0.0 1.0 1.0 1.0"/>
  </material>
  <material name="magenta">
    <color rgba="1.0 0.0 1.0 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="1.0 1.0 0.0 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <inertia ixx="2.17" ixy="0" ixz="0" iyy="0.083" iyz="0" izz="2.08"/>
    </inertial>

    <!-- Top Stripe: Cyan -->
    <visual>
      <origin xyz="0 0 0.833" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.333"/>
      </geometry>
      <material name="cyan"/>
    </visual>

    <!-- Middle Stripe: Magenta -->
    <visual>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.334"/>
      </geometry>
      <material name="magenta"/>
    </visual>

    <!-- Bottom Stripe: Yellow -->
    <visual>
      <origin xyz="0 0 0.167" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 0.333"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.8 1.0"/>
      </geometry>
    </collision>
  </link>
</robot>
