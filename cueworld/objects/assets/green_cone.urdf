<?xml version="1.0"?>
<robot name="green_cone">
  <link name="base_link">
    <contact>
      <lateral_friction value="0.9"/>
      <rolling_friction value="0.08"/>
      <spinning_friction value="0.06"/>
      <restitution value="0.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="cone.obj" scale="1 1 1"/>
      </geometry>
      <material name="green">
        <color rgba="0.180 0.720 0.280 1.000"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="cone.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
</robot>
