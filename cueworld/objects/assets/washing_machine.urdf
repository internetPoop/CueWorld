<?xml version="1.0"?>
<robot name="washing_machine">
  <material name="body_mat">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="door_mat">
    <color rgba="0.7 0.8 0.9 1.0"/>
  </material>
  <material name="inside_mat">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="30.0"/>
      <origin xyz="0 0 0.4" rpy="0 0 0"/>
      <inertia ixx="1.6" ixy="0" ixz="0" iyy="1.6" iyz="0" izz="1.8"/>
    </inertial>
    
    <!-- Bottom -->
    <visual><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><box size="0.6 0.6 0.05"/></geometry><material name="inside_mat"/></visual>
    <collision><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><box size="0.6 0.6 0.05"/></geometry></collision>

    <!-- Top -->
    <visual><origin xyz="0 0 0.775" rpy="0 0 0"/><geometry><box size="0.6 0.6 0.05"/></geometry><material name="body_mat"/></visual>
    <collision><origin xyz="0 0 0.775" rpy="0 0 0"/><geometry><box size="0.6 0.6 0.05"/></geometry></collision>

    <!-- Left -->
    <visual><origin xyz="-0.275 0 0.4" rpy="0 0 0"/><geometry><box size="0.05 0.6 0.7"/></geometry><material name="body_mat"/></visual>
    <collision><origin xyz="-0.275 0 0.4" rpy="0 0 0"/><geometry><box size="0.05 0.6 0.7"/></geometry></collision>

    <!-- Right -->
    <visual><origin xyz="0.275 0 0.4" rpy="0 0 0"/><geometry><box size="0.05 0.6 0.7"/></geometry><material name="body_mat"/></visual>
    <collision><origin xyz="0.275 0 0.4" rpy="0 0 0"/><geometry><box size="0.05 0.6 0.7"/></geometry></collision>

    <!-- Back -->
    <visual><origin xyz="0 -0.275 0.4" rpy="0 0 0"/><geometry><box size="0.5 0.05 0.7"/></geometry><material name="body_mat"/></visual>
    <collision><origin xyz="0 -0.275 0.4" rpy="0 0 0"/><geometry><box size="0.5 0.05 0.7"/></geometry></collision>
  </link>

  <link name="door_link">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.04"/>
    </inertial>
    <visual>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.05 0.7"/></geometry>
      <material name="door_mat"/>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 0 0"/>
      <geometry><box size="0.5 0.05 0.7"/></geometry>
    </collision>
  </link>

  <joint name="door_joint" type="revolute">
    <parent link="base_link"/>
    <child link="door_link"/>
    <origin xyz="-0.25 0.275 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.0" effort="100.0" velocity="1.0"/>
    <dynamics damping="1.0" friction="1.0"/>
  </joint>
</robot>
